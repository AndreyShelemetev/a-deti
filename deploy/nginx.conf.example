# /etc/nginx/sites-available/a-deti.conf — reverse proxy in front of the Next.js server (pm2, port 3000)
server {
    listen 80;
    server_name a-deti.ru www.a-deti.ru;

    client_max_body_size 20m;           # image uploads from the admin panel
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # long-lived static assets
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache_valid 200 30d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
# After enabling: sudo ln -s /etc/nginx/sites-available/a-deti.conf /etc/nginx/sites-enabled/ && sudo nginx -t && sudo systemctl reload nginx
# HTTPS: sudo apt install certbot python3-certbot-nginx && sudo certbot --nginx -d a-deti.ru -d www.a-deti.ru
