// A-tour (a-deti.ru) — Prisma schema
// Content model for a children's holiday tour operator site with an admin panel.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum TourType {
  CAMP       // лагеря отдыха
  FAMILY     // семейный отдых
  SPORT      // спортивные сборы
  EXCURSION  // экскурсионные туры
  TRANSFER   // авиа и жд
  YOUTH      // молодёжные программы (Work & Travel, Camp Counselors)
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

enum PostKind {
  NEWS
  ARTICLE
}

enum RequestKind {
  REQUEST   // общая заявка с сайта
  CALLBACK  // заказ звонка
  BOOKING   // бронирование тура / смены
  SUBSCRIBE // подписка на новости
  AGENCY    // запрос доступа для агентства
  REVIEW    // отзыв с сайта (модерируется)
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  DONE
  SPAM
}

enum PaymentStatus {
  NEW
  REDIRECTED
  PAID
  FAILED
  CANCELLED
}

enum ReviewSource {
  YANDEX
  GOOGLE
  SITE
}

enum UserRole {
  ADMIN
  MANAGER
}

// ───────────────────────── Catalog ─────────────────────────

model Region {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  name      String
  isForeign Boolean @default(false)
  sortOrder Int     @default(0)
  tours     Tour[]
}

/// Характеристика тура (тег): "на море", "спортивный", "языковой"…
model Tag {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  label           String
  h1              String?
  seoTitle        String?
  metaDescription String?
  sortOrder       Int       @default(0)
  tours           TourTag[]
}

model Tour {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  legacyId        Int?
  title           String
  seoTitle        String?
  metaDescription String?
  metaKeywords    String?
  short           String   @default("")
  address         String   @default("")
  ageText         String   @default("")
  ageMin          Int?
  ageMax          Int?
  website         String?
  priceText       String?
  priceMin        Int?
  cover           String?
  type            TourType @default(CAMP)
  seasons         Season[]
  seasonText      String?
  isBest          Boolean  @default(false)
  isHit           Boolean  @default(false)
  isPublished     Boolean  @default(true)
  sortOrder       Int      @default(0)
  searchText      String   @default("")
  regionId        Int?
  region          Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shifts    TourShift[]
  images    TourImage[]
  sections  TourSection[]
  tags      TourTag[]
  documents TourDocument[]
  requests  Request[]
  reviews   Review[]

  @@index([isPublished, sortOrder])
  @@index([type])
}

/// Смена / заезд с ценой. `group` — корпус/программа (например, дружины «Орлёнка»).
model TourShift {
  id        Int     @id @default(autoincrement())
  tourId    Int
  tour      Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  group     String?
  name      String
  startDate DateTime?
  endDate   DateTime?
  price     Int?
  priceText String?
  sortOrder Int     @default(0)

  @@index([tourId])
}

model TourImage {
  id        Int    @id @default(autoincrement())
  tourId    Int
  tour      Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int    @default(0)

  @@index([tourId])
}

/// Вкладки карточки тура: описание, проживание, программа, стоимость, документы, противопоказания…
model TourSection {
  id        Int    @id @default(autoincrement())
  tourId    Int
  tour      Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  key       String
  title     String
  html      String
  sortOrder Int    @default(0)

  @@unique([tourId, key])
}

model TourTag {
  tourId Int
  tagId  Int
  tour   Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tourId, tagId])
  @@index([tagId])
}

model TourDocument {
  id        Int    @id @default(autoincrement())
  tourId    Int
  tour      Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  label     String
  url       String
  sortOrder Int    @default(0)

  @@index([tourId])
}

/// SEO-страница каталога (/tour/filter/<path>/): правило отбора + тексты.
model CatalogPage {
  id              Int       @id @default(autoincrement())
  path            String    @unique
  h1              String
  seoTitle        String?
  metaDescription String?
  seoText         String?
  type            TourType?
  regionSlugs     String[]  @default([])
  tagSlugs        String[]  @default([])
  season          Season?
  isIndexable     Boolean   @default(true)
  sortOrder       Int       @default(0)
}

// ───────────────────────── Content ─────────────────────────

model Post {
  id              Int      @id @default(autoincrement())
  kind            PostKind
  slug            String
  title           String
  seoTitle        String?
  metaDescription String?
  excerpt         String?
  image           String?
  html            String
  publishedAt     DateTime @default(now())
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([kind, slug])
  @@index([kind, isPublished, publishedAt])
}

model Page {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  title           String
  seoTitle        String?
  metaDescription String?
  metaKeywords    String?
  html            String   @default("")
  isPublished     Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model Partner {
  id        Int     @id @default(autoincrement())
  name      String
  logo      String
  url       String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

enum SlidePlacement {
  HERO // главный слайдер
  HIT  // блок «Хиты продаж»
}

model Slide {
  id        Int            @id @default(autoincrement())
  placement SlidePlacement @default(HERO)
  image     String
  href      String?
  title     String?
  subtitle  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

/// Блок «Коротко о нас» на главной
model Feature {
  id        Int    @id @default(autoincrement())
  icon      String?
  text      String
  sortOrder Int    @default(0)
}

model ReviewPlatform {
  id     Int    @id @default(autoincrement())
  name   String
  logo   String?
  url    String
  rating Float
  max    Int    @default(5)
  sortOrder Int @default(0)
}

model Review {
  id          Int          @id @default(autoincrement())
  author      String
  text        String
  rating      Int          @default(5)
  source      ReviewSource @default(SITE)
  sourceUrl   String?
  publishedAt DateTime     @default(now())
  isPublished Boolean      @default(true)
  tourId      Int?
  tour        Tour?        @relation(fields: [tourId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([isPublished, publishedAt])
}

// ───────────────────────── Leads & payments ─────────────────────────

model Request {
  id        Int           @id @default(autoincrement())
  kind      RequestKind
  status    RequestStatus @default(NEW)
  name      String?
  email     String?
  phone     String?
  message   String?
  tourId    Int?
  tour      Tour?         @relation(fields: [tourId], references: [id], onDelete: SetNull)
  tourTitle String?
  shiftName String?
  amount    Int?
  pageUrl   String?
  payload   Json?
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([kind])
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderNumber    String
  fullName       String
  phone          String?
  email          String
  amount         Int
  isMirCard      Boolean       @default(false)
  status         PaymentStatus @default(NEW)
  gatewayOrderId String?
  gatewayUrl     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ───────────────────────── System ─────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(MANAGER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Redirect {
  id         Int    @id @default(autoincrement())
  from       String @unique
  to         String
  statusCode Int    @default(301)
}

/// История обновлений сайта из админки (/admin/update/)
model Deployment {
  id         Int      @id @default(autoincrement())
  ref        String
  jobId      String?
  commit     String?
  status     String   @default("running") // running | success | failed
  startedBy  String?
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  log        String?
}
