# Copy via bash ops/setup.sh --local (it also creates random secret files).
COMPOSE_PROJECT_NAME=a-deti
APP_IMAGE=a-deti:local
BUILD=local
APP_PORT=8080
MARIADB_DATABASE=atour
MARIADB_USER=atour
AT_SECRETS_DIR=./.secrets
# When a domain is available: example.org and a real certificate contact.
SITE_ADDRESS=http://localhost
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443
