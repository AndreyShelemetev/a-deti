# PostgreSQL connection string
DATABASE_URL="postgresql://adeti:adeti@localhost:5432/adeti?schema=public"

# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret for signing admin session cookies (min 32 random chars)
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Initial admin user created by `pnpm db:seed`
ADMIN_EMAIL="admin@a-deti.ru"
ADMIN_PASSWORD="admin12345"

# Yandex.Metrika counter id (optional)
NEXT_PUBLIC_YANDEX_METRIKA_ID=""

# Outgoing e-mail for lead notifications (optional; leads are always stored in DB)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="site@a-deti.ru"
LEADS_EMAIL="zakaz@a-deti.ru"

# Online payment gateway (Sberbank acquiring) — optional
PAYMENT_GATEWAY_URL=""
PAYMENT_GATEWAY_LOGIN=""
PAYMENT_GATEWAY_PASSWORD=""
